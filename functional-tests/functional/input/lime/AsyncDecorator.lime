package test

// Some class that represents the old-style asynchronous handle.
// It can be used to check if task is running or has been cancelled.
// It allows also to cancel the task.
@AsyncTaskHandleMetadata(CancelFunction="cancel")
class AsyncTaskHandle {
    // Cancels the running asynchronous task.
    fun cancel(): Boolean

    // Checks if the task has been already cancelled.
    fun isCancelled(): Boolean

    // Checks if the task is being running just now.
    fun isRunning(): Boolean
}

// Specifies possible errors that may result from the asynchronous engine work.
enum EngineError {
    // Generic internal error.
    INTERNAL_ERROR = 1,
    // An invalid input parameter.
    INVALID_PARAMETER = 2,
    // Engine on fire.
    ENGINE_ON_FIRE = 3
}

// A function, which is called when the asynchronous processing is done by the engine.
// Outcome of engine work is list of strings.
// @param[engineError] The error in case of a failure. It is `null` for an operation that succeeds.
// @param[engineResult] The result from engine. It is `null` in case of an error.
@AsyncCallbackMetadata(ErrorField="engineError")
lambda EngineWorkCompletedCallback = (engineError: EngineError?, engineResult: List<String>?) -> Void

// An engine class, which offers users some asynchronous processing.
class CoolEngine {
    // Creates engine ready to work.
    constructor make()

    // A function, which downloads some 'cool labels' from the given url.
    // When it finishes, the 'callback' is called.
    // It returns the 'AsyncTaskHandle' which allows checking the status and cancelling the async task.
    @AsyncDecorator
    fun downloadCoolLabelsAsync(url: String, callback: EngineWorkCompletedCallback): AsyncTaskHandle

    // A function which returns the number of total asynchronous tasks started for this engine.
    fun getTotalTasksStarted(): Int

    // A function which returns the count of cancelled tasks.
    fun getCancelledTasksCount(): Int

    // Waits for all previously scheduled tasks.
    fun waitForCompletion()
}
