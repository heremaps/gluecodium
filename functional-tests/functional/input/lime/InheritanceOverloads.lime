package test

struct MagicHandle {
    memory_address: Long
}

struct ParentMethodParameters {
    first_handle: MagicHandle
    second_handle: MagicHandle
    third_handle: MagicHandle
}

interface ParentInterfaceType {
    fun refresh(handles: ParentMethodParameters, label: String): Int
}

class ChildClassImplementingInterfaceType : ParentInterfaceType {
    fun refresh(handle: MagicHandle, label: String): Int

    constructor make()
}

open class ParentClassType {
    fun refresh(handles: ParentMethodParameters, label: String): Int
}

open class ChildClassDerivedFromParentType : ParentClassType {
    fun refresh(handle: MagicHandle, label: String): Int

    constructor make()
}

interface AnotherParentInterfaceType : ParentInterfaceType {
    fun refresh(handle: MagicHandle, label: String): Int
}

class ChildClassImplementingMultipleInterfaceTypes : AnotherParentInterfaceType {
    fun refresh(label: String): Int

    constructor make()
}

interface ParentInterfaceOverloads {
    fun foo()
    @Dart("fooInt")
    fun foo(input: Int)
    fun bar()
    fun baz()
}

open class ParentClassOverloads {
    fun foo()
    @Dart("fooInt")
    fun foo(input: Int)
    fun bar()
    fun baz()
}

interface ChildInterfaceOverloads: ParentInterfaceOverloads {
    @Dart("fooString")
    fun foo(input: String)
    @Dart("barString")
    fun bar(input: String)
}

class ChildClassFromInterfaceOverloads: ParentInterfaceOverloads {
    @Dart("fooString")
    fun foo(input: String)
    @Dart("barString")
    fun bar(input: String)
}

class ChildClassFromClassOverloads: ParentClassOverloads {
    @Dart("fooString")
    fun foo(input: String)
    @Dart("barString")
    fun bar(input: String)
}
