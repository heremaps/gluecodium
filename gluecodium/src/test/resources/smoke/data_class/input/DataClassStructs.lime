package smoke

// The kind of a place.
enum PlaceType {
    POI,
    AREA,
    STREET
}

// An immutable representation of a searchable place.
@Immutable
@Equatable
@Kotlin(DataClass)
struct Place {
    // The human-readable name of the place.
    title: String
    // The unique identifier of the place.
    id: String
    // The kind of the place.
    place_type: PlaceType
    // The latitude of the place, in degrees.
    latitude: Double
    // The longitude of the place, in degrees.
    longitude: Double
    // The distance from the search origin to the place, in meters, if known.
    distance_in_meters: Int? = null
    // The political view under which this place was resolved, if any.
    political_view: String? = null

    // Serializes this place into a compact string representation.
    fun serialize_compact(): String

    // Deserializes a place from its compact string representation.
    static fun deserialize(serialized_place: String): Place
}

// The kind of a search suggestion.
enum SuggestionType {
    CATEGORY,
    CHAIN,
    PLACE
}

// An immutable representation of a single search suggestion.
@Immutable
@Kotlin(DataClass)
struct Suggestion {
    // The human-readable title of the suggestion.
    title: String
    // The kind of the suggestion.
    type: SuggestionType
    // The place this suggestion resolves to, if already known.
    place: Place? = null
    // The unique identifier of the suggestion, if any.
    id: String? = null
    // A reference that can be used to resolve this suggestion into a place, if any.
    href: String? = null

    // Returns the character ranges within the title that matched the search query.
    fun getHighlights(): Map<String, List<Int>>
}
