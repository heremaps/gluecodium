package coroutines

enum OperationError {
    FAILED
}

class OperationHandle {
    fun cancel()
}

lambda ErrorValueCallback = (
    error: @KotlinCoroutine(Error) OperationError?,
    value: @KotlinCoroutine(Result) String?
) -> Void

lambda ErrorOnlyCallback = (
    error: @KotlinCoroutine(Error) OperationError?
) -> Void

lambda ValueOnlyCallback = (
    value: @KotlinCoroutine(Result) String?
) -> Void

lambda CompletionCallback = () -> Void

lambda MultiValueCallback = (
    error: @KotlinCoroutine(Error) OperationError?,
    count: @KotlinCoroutine(Result) Int?,
    label: @KotlinCoroutine(Result) String?
) -> Void

lambda TickCallback = (
    tick: @KotlinCoroutine(Result) Int
) -> Void

# The error member is declared last and the result member is not marked, so both are resolved by convention.
lambda TrailingErrorCallback = (
    value: String?,
    error: @KotlinCoroutine(Error) OperationError?
) -> Void

interface ProgressListener {
    @KotlinCoroutine(Emit)
    fun on_progress(percentage: Int)

    @KotlinCoroutine(Complete)
    fun on_complete(@KotlinCoroutine(Error) error: OperationError?)
}

interface TransferListener {
    @KotlinCoroutine(Emit)
    fun on_progress(percentage: Int)

    @KotlinCoroutine(Complete)
    fun on_complete(
        @KotlinCoroutine(Error) error: OperationError?,
        @KotlinCoroutine(Result) receipt: String?
    )
}

interface UpdateListener {
    @KotlinCoroutine(Emit)
    fun on_update(identifier: Int, message: String)
}

interface StateListener {
    @KotlinCoroutine(Emit)
    fun on_started()

    @KotlinCoroutine(Emit)
    fun on_message(message: String)
}

interface RemoteService {
    // Checks whether the remote service is currently reachable.
    @KotlinCoroutine
    fun check_connection(@KotlinCoroutine(Callback) callback: ErrorOnlyCallback)
}

class CoroutineClient {
    @KotlinCoroutine(Name = "loadValueAsync")
    fun load_value(@KotlinCoroutine(Callback) callback: ErrorValueCallback): OperationHandle

    @KotlinCoroutine
    fun clear_cache(@KotlinCoroutine(Callback) callback: ErrorOnlyCallback)

    // Resolves the display name for the current account.
    @KotlinCoroutine
    fun resolve_name(@KotlinCoroutine(Callback) callback: ValueOnlyCallback)

    @KotlinCoroutine
    fun synchronize(@KotlinCoroutine(Callback) callback: CompletionCallback)

    @KotlinCoroutine
    fun load_metadata(@KotlinCoroutine(Callback) callback: MultiValueCallback): OperationHandle

    # The callback parameter is not marked, so it is resolved by convention as the sole callback-typed parameter.
    @KotlinCoroutine
    fun list_features(callback: TrailingErrorCallback)

    @KotlinCoroutine(Flow)
    fun observe_ticks(@KotlinCoroutine(Callback) callback: TickCallback): OperationHandle

    @KotlinCoroutine(Flow)
    fun download(@KotlinCoroutine(Callback) listener: ProgressListener): OperationHandle

    @KotlinCoroutine(Flow)
    fun transfer(@KotlinCoroutine(Callback) listener: TransferListener): OperationHandle

    @KotlinCoroutine(Flow)
    fun add_update_listener(@KotlinCoroutine(Callback) listener: UpdateListener)

    @KotlinCoroutine(Unregister)
    fun remove_update_listener(listener: UpdateListener)

    @KotlinCoroutine(Flow)
    fun add_state_listener(@KotlinCoroutine(Callback) listener: StateListener)

    @KotlinCoroutine(Unregister)
    fun remove_state_listener(listener: StateListener)
}
