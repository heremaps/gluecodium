package coroutines

enum OperationError {
    FAILED
}

class OperationHandle {
    fun cancel()
}

# The cancel hook is explicit, so it does not have to be named `cancel`.
class AbortableHandle {
    @AsyncTaskHandle
    fun abort()
}

lambda ErrorValueCallback = (
    error: @AsyncDecorator(Error) OperationError?,
    value: @AsyncDecorator(Result) String?
) -> Void

lambda ErrorOnlyCallback = (
    error: @AsyncDecorator(Error) OperationError?
) -> Void

lambda ValueOnlyCallback = (
    value: @AsyncDecorator(Result) String?
) -> Void

lambda CompletionCallback = () -> Void

lambda MultiValueCallback = (
    error: @AsyncDecorator(Error) OperationError?,
    count: @AsyncDecorator(Result) Int?,
    label: @AsyncDecorator(Result) String?
) -> Void

lambda TickCallback = (
    tick: @AsyncDecorator(Result) Int
) -> Void

# The error member is declared last and the result member is not marked, so both are resolved by convention.
lambda TrailingErrorCallback = (
    value: String?,
    error: @AsyncDecorator(Error) OperationError?
) -> Void

interface ProgressListener {
    @AsyncDecorator(Emit)
    fun on_progress(percentage: Int)

    @AsyncDecorator(Complete)
    fun on_complete(@AsyncDecorator(Error) error: OperationError?)
}

interface TransferListener {
    @AsyncDecorator(Emit)
    fun on_progress(percentage: Int)

    @AsyncDecorator(Complete)
    fun on_complete(
        @AsyncDecorator(Error) error: OperationError?,
        @AsyncDecorator(Result) receipt: String?
    )
}

interface UpdateListener {
    @AsyncDecorator(Emit)
    fun on_update(identifier: Int, message: String)
}

interface StateListener {
    @AsyncDecorator(Emit)
    fun on_started()

    @AsyncDecorator(Emit)
    fun on_message(message: String)
}

interface RemoteService {
    // Checks whether the remote service is currently reachable.
    @AsyncDecorator
    fun check_connection(@AsyncDecorator(Callback) callback: ErrorOnlyCallback)
}

# Structs are supported receivers, not just classes.
struct UploadSession {
    label: String

    @AsyncDecorator
    fun upload(@AsyncDecorator(Callback) callback: ErrorValueCallback)

    @AsyncDecorator
    static fun open_session(@AsyncDecorator(Callback) callback: ErrorOnlyCallback)
}

class CoroutineClient {
    # A nested type must not pick up the enclosing class's coroutine members.
    struct Options {
        retry_count: Int
    }

    @AsyncDecorator(Name = "loadValueAsync")
    fun load_value(@AsyncDecorator(Callback) callback: ErrorValueCallback): OperationHandle

    # Static functions belong in the companion object, not the class body.
    @AsyncDecorator
    static fun preload(@AsyncDecorator(Callback) callback: ErrorOnlyCallback)

    # Cancellation resolved via `@AsyncTaskHandle`, not via the `cancel()` name convention.
    @AsyncDecorator
    fun refresh(@AsyncDecorator(Callback) callback: ErrorOnlyCallback): AbortableHandle

    @AsyncDecorator
    fun clear_cache(@AsyncDecorator(Callback) callback: ErrorOnlyCallback)

    // Resolves the display name for the current account.
    @AsyncDecorator
    fun resolve_name(@AsyncDecorator(Callback) callback: ValueOnlyCallback)

    @AsyncDecorator
    fun synchronize(@AsyncDecorator(Callback) callback: CompletionCallback)

    @AsyncDecorator
    fun load_metadata(@AsyncDecorator(Callback) callback: MultiValueCallback): OperationHandle

    # The callback parameter is not marked, so it is resolved by convention as the sole callback-typed parameter.
    @AsyncDecorator
    fun list_features(callback: TrailingErrorCallback)

    @AsyncDecorator(Flow)
    fun observe_ticks(@AsyncDecorator(Callback) callback: TickCallback): OperationHandle

    @AsyncDecorator(Flow)
    fun download(@AsyncDecorator(Callback) listener: ProgressListener): OperationHandle

    @AsyncDecorator(Flow)
    fun transfer(@AsyncDecorator(Callback) listener: TransferListener): OperationHandle

    @AsyncDecorator(Flow)
    fun add_update_listener(@AsyncDecorator(Callback) listener: UpdateListener)

    @AsyncDecorator(Unregister)
    fun remove_update_listener(listener: UpdateListener)

    @AsyncDecorator(Flow)
    fun add_state_listener(@AsyncDecorator(Callback) listener: StateListener)

    @AsyncDecorator(Unregister)
    fun remove_state_listener(listener: StateListener)
}
