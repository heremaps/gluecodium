/**
 * Generic bridge that adapts a callback-style [startOperation] into a `suspend` call returning [Result].
 *
 * Behavior:
 * - resumes with [Result.success] carrying the callback value,
 * - resumes with [Result.failure] produced by [mapDomainError] on a domain error,
 * - fails with [{{contractViolationName}}] if the callback breaks the (error XOR result) contract,
 * - propagates a synchronous throwable from [startOperation],
 * - cancels the underlying task via [cancelOperation] when the coroutine is cancelled before the
 *   callback resolves. The cancellation path shares the `resolved` guard with the callback, so a
 *   cancellation racing a completing callback never cancels an already-finished task.
 *
 * @param startOperation starts the underlying async operation and returns a handle.
 * @param mapDomainError converts the domain-specific error value into a [Throwable].
 * @param cancelOperation requests cancellation of the in-flight operation; the task may still
 *   complete on the native side.
 */
internal suspend fun <E, T, H> {{resultBridgeName}}(
    startOperation: (callback: (E?, T?) -> Unit) -> H,
    mapDomainError: (E) -> Throwable,
    cancelOperation: (H) -> Unit,
): T =
    suspendCancellableCoroutine { continuation ->
        // Guards two races that `suspendCancellableCoroutine` does not cover on its own: a native callback
        // firing more than once, and `cancelOperation` running after the callback already resolved.
        val resolved = java.util.concurrent.atomic.AtomicBoolean(false)
        val handle: H? =
            try {
                startOperation { error, value ->
                    if (resolved.compareAndSet(false, true)) {
                        when {
                            error == null && value != null -> continuation.resume(value)
                            error != null && value == null -> continuation.resumeWithException(mapDomainError(error))
                            error == null && value == null ->
                                continuation.resumeWithException({{contractViolationName}}("Callback contract violation: both error and value are null"))
                            else ->
                                continuation.resumeWithException({{contractViolationName}}("Callback contract violation: both error and value are non-null"))
                        }
                    }
                }
            } catch (throwable: Throwable) {
                if (resolved.compareAndSet(false, true)) {
                    continuation.resumeWithException(throwable)
                }
                null
            }
        if (handle != null) {
            continuation.invokeOnCancellation {
                if (resolved.compareAndSet(false, true)) {
                    cancelOperation(handle)
                }
            }
        }
    }

